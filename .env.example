# Database
VIRAL_DATABASE_URL=postgresql://user:password@localhost:5432/viralengine

# LLM
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5-20251001

# Twitter/X API — app-level keys (shared across all accounts)
# Per-account access tokens are stored in the accounts table credentials JSONB
TWITTER_API_KEY=...
TWITTER_API_SECRET=...

# Worker
WORKER_ID=worker-1
ASSET_DIR=./assets

# Web
PORT=3001
AUTH_SECRET=change-me-in-production
